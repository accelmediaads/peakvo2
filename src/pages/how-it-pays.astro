---
import '../styles/peakvo2-brand.css';

const accelLogo = '/logos/AccelLogo-Horizontal.png';

// Every figure below comes from PeakVO₂'s own numbers (Jackson, Aug 5): $999 retail, $650 landed
// cost, Stripe ~2.9% + $0.30, 3% warranty reserve, ~20% app-store fee on individual mobile subs,
// commercial billed direct via Stripe. Commission = Jackson's structure as written.

const device = [
  { line: 'Customer pays', amt: '$999', kind: 'in' },
  { line: 'Landed cost per unit', amt: '$650', kind: 'cost' },
  { line: 'Payment processing (Stripe, your estimate)', amt: '$29', kind: 'cost' },
  { line: 'Warranty reserve (3%)', amt: '$30', kind: 'cost' },
  { line: 'Gross profit before marketing', amt: '$290', kind: 'sub' },
  { line: 'Accel commission (one time)', amt: '$50', kind: 'cost' },
  { line: 'You keep', amt: '$240', kind: 'total' },
];

const subs = [
  {
    t: 'Individuals (billed through the app stores)',
    rows: [
      ['Pro annual', '$200', 'about $40 to Apple / Google', '$160', '$20 once', '$140', '$160, all yours'],
      ['Pro monthly', '$20 / mo', 'about $4 / mo', '$16 / mo', '$5 once', '$187 in year one', '$192 / yr, all yours'],
    ],
  },
  {
    t: 'Commercial (billed direct through Stripe, no app-store cut)',
    rows: [
      ['Small gym, annual', '$1,000', 'about $29', '$971', '$100 once', '$871', '$971 / yr, all yours'],
      ['Large gym, annual', '$2,000', 'about $58', '$1,942', '$200 once', '$1,742', '$1,942 / yr, all yours'],
    ],
  },
];

// Full first-year picture per customer: device + subscription together.
const yearOne = [
  { who: 'Individual, device only', pays: '$999', costs: '$709', accel: '$50', keeps: '$240', share: '17%', renew: 'n/a' },
  { who: 'Individual, device + Pro monthly', pays: '$1,239', costs: '$757', accel: '$55', keeps: '$427', share: '11%', renew: '$192 / yr' },
  { who: 'Individual, device + Pro annual', pays: '$1,199', costs: '$749', accel: '$70', keeps: '$380', share: '16%', renew: '$160 / yr' },
  { who: 'Small gym, device + annual', pays: '$1,999', costs: '$738', accel: '$150', keeps: '$1,111', share: '12%', renew: '$971 / yr' },
  { who: 'Large gym, device + annual', pays: '$2,999', costs: '$767', accel: '$250', keeps: '$1,982', share: '11%', renew: '$1,942 / yr', highlight: true },
];

// A month, both sides: 16 devices (5 Basic, 6 Pro annual, 4 Pro monthly, 1 small gym annual).
const month = [
  { line: '16 devices sold', calc: '16 × $999', amt: '$15,984', kind: 'in' },
  { line: 'Device costs (landed + processing + reserve)', calc: '16 × $709', amt: '$11,344', kind: 'cost' },
  { line: 'Subscriptions collected, net of app-store and Stripe fees', calc: '6 annual + 4 monthly + 1 gym', amt: '$1,995', kind: 'in' },
  { line: 'Gross profit before marketing', calc: '', amt: '$6,635', kind: 'sub' },
  { line: 'Accel commission', calc: '5 × $50 + 6 × $70 + 4 × $55 + $150', amt: '$1,040', kind: 'cost' },
  { line: 'Accel campaign management', calc: 'flat', amt: '$750', kind: 'cost' },
  { line: 'You keep', calc: 'before ad spend, which stays in your accounts', amt: '$4,845', kind: 'total' },
];

const parts = [
  { n: '01', t: 'Campaign management', amt: '$750 / month', d: 'Building and running the Meta, YouTube, and Google campaigns, landing pages, and tracking. Ad spend is separate, in your accounts, at a budget you set.' },
  { n: '02', t: 'Commission per sale', amt: 'one time', d: '$50 per device plus the subscription figure above, paid once at the first sale. Nothing recurring. Every renewal is 100% yours.' },
  { n: '03', t: 'Production at partner rate', amt: '$1,750', d: 'Launch hype reel, 30 second homepage cut, and three social verticals from one shoot day. Half the standard rate because the partnership pays on results.' },
];

const rules = [
  { t: 'Tracked ad, 60 to 90 day window', d: 'A customer who touched a tracked ad in the previous 60 to 90 days is credited to the campaigns, no matter who closes the sale. Source is captured automatically on the form. Proposed.' },
  { t: 'Paid on net sales', d: 'Commission is calculated after the 30 day return window closes, so returns come off before anything is paid.' },
  { t: 'Not credited', d: 'Sales your team sources directly by phone with no tracked ad touch, and the gyms already in your pipeline before launch.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The PeakVO₂ × Accel Media partnership economics, both sides, on one page." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <title>PeakVO₂ × Accel Media | The Economics</title>
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="cobrand">
        <span class="cobrand-client font-display">PEAKVO<sub>2</sub></span>
        <span class="cobrand-x">×</span>
        <img src={accelLogo} alt="Accel Media" class="cobrand-logo" />
      </a>
      <a href="/partnership" class="backlink">← Back to the partnership</a>
    </header>

    <main>
      <section class="hero-lite">
        <div class="wrap">
          <p class="aw-eyebrow">The Performance Partnership</p>
          <h1 class="lite-title">The economics,<br /><span class="hero-dim">both sides.</span></h1>
          <p class="band-body lead">
            Every number on this page is yours: $999 retail, $650 landed cost, your processing and
            warranty estimates, your subscription tiers. Accel earns one commission per customer,
            paid once at the first sale. Every renewal after that is 100% yours.
          </p>
        </div>
      </section>

      <!-- ============ ONE DEVICE ============ -->
      <section class="band tightband">
        <div class="wrap">
          <h2 class="band-title">One device, start to finish</h2>
          <div class="ledger">
            {device.map((d) => (
              <div class:list={['ledger-row', d.kind]}>
                <span class="l-line">{d.line}</span>
                <span class="l-amt">{d.amt}</span>
              </div>
            ))}
          </div>
          <p class="context-note">
            Shipping is paid by the customer, so it is not in the stack. Accel's $50 is about 17% of
            the $290 gross profit on a device sale. That share drops as landed cost comes down with
            injection molding, and the commission does not move.
          </p>
        </div>
      </section>

      <!-- ============ SUBSCRIPTIONS ============ -->
      <section class="band alt">
        <div class="wrap">
          <h2 class="band-title">Subscriptions</h2>
          <p class="band-body">
            Accel is paid once when the subscription starts. Renewals are never commissioned.
          </p>
          {subs.map((g) => (
            <div class="sub-group">
              <h3 class="sub-h">{g.t}</h3>
              <div class="scroll">
                <div class="grid-table sub-table" role="table">
                  <div class="g-head" role="row">
                    <span>Plan</span><span>Customer pays</span><span>Platform fee</span><span>Net to you</span><span>Accel</span><span>You keep, year one</span><span>Every renewal</span>
                  </div>
                  {g.rows.map((r) => (
                    <div class="g-row" role="row">
                      {r.map((c, i) => <span class:list={[{ 'g-accent': i === 5, 'g-strong': i === 6 }]}>{c}</span>)}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ PER CUSTOMER, YEAR ONE ============ -->
      <section class="band">
        <div class="wrap">
          <h2 class="band-title">Each customer, year one</h2>
          <p class="band-body">Device and subscription together. Costs are landed cost, processing, warranty reserve, and any app-store fee.</p>
          <div class="scroll">
            <div class="grid-table y1-table" role="table">
              <div class="g-head" role="row">
                <span>Customer</span><span>Pays</span><span>Your costs</span><span>Accel</span><span>You keep</span><span>Accel's share of profit</span><span>Every renewal, 100% yours</span>
              </div>
              {yearOne.map((y) => (
                <div class:list={['g-row', { highlight: y.highlight }]} role="row">
                  <span>{y.who}</span><span>{y.pays}</span><span>{y.costs}</span><span>{y.accel}</span><span class="g-accent">{y.keeps}</span><span>{y.share}</span><span class="g-strong">{y.renew}</span>
                </div>
              ))}
            </div>
          </div>
          <p class="context-note">
            Across every customer type, Accel takes 11 to 17% of first-year gross profit and nothing
            after. Gyms are the biggest line items for both of us, and they are where the campaigns
            will push hardest.
          </p>
        </div>
      </section>

      <!-- ============ A MONTH, BOTH SIDES ============ -->
      <section class="band alt">
        <div class="wrap">
          <p class="aw-eyebrow">A realistic early month</p>
          <h2 class="band-title">16 devices, both sides</h2>
          <p class="band-body">Five Basic, six Pro annual, four Pro monthly, and one small gym on an annual plan.</p>
          <div class="ledger">
            {month.map((m) => (
              <div class:list={['ledger-row', m.kind]}>
                <span class="l-line">{m.line}<em>{m.calc}</em></span>
                <span class="l-amt">{m.amt}</span>
              </div>
            ))}
          </div>
          <p class="context-note">
            Accel's total that month, commission plus management, is $1,790, or about 27% of gross
            profit. At 40 devices and two gyms, Accel's total is roughly $3,500 against about $16,000
            in gross profit, closer to 22%. The fee is flat, so the share shrinks as you grow.
          </p>
        </div>
      </section>

      <!-- ============ THREE PARTS ============ -->
      <section class="band">
        <div class="wrap">
          <h2 class="band-title">The three parts</h2>
          <div class="part-grid">
            {parts.map((p) => (
              <div class="part-card">
                <span class="part-num font-display">{p.n}</span>
                <h4>{p.t}</h4>
                <p class="part-amt">{p.amt}</p>
                <p>{p.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CREDIT RULES ============ -->
      <section class="band alt">
        <div class="wrap">
          <h2 class="band-title">How a sale gets credited</h2>
          <div class="rule-list">
            {rules.map((r) => (
              <div class="rule-card">
                <h4>{r.t}</h4>
                <p>{r.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CLOSE ============ -->
      <section class="band close">
        <div class="wrap">
          <h2 class="close-title">That's the whole structure.</h2>
          <div class="cta-row">
            <a href="tel:+12086590834" class="aw-btn-primary">Call (208) 659-0834</a>
            <a href="/partnership" class="aw-btn-secondary">Back to the partnership</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <span class="cobrand-client font-display" style="font-size:0.9rem;">PEAKVO<sub>2</sub></span>
        <span class="cobrand-x">×</span>
        <img src={accelLogo} alt="Accel Media" class="cobrand-logo" />
      </div>
      <span>Prepared by Accel Media for PeakVO₂ Analytics. Confidential.</span>
    </footer>

    <style is:global>
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      sub { font-size: 0.6em; line-height: 0; }

      /* ---- top bar ---- */
      .topbar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.85rem 1.5rem;
        background: rgba(7, 9, 13, 0.72); backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--aw-border);
      }
      .cobrand { display: flex; align-items: center; gap: 0.55rem; }
      .cobrand-client { font-size: 1rem; letter-spacing: 0.14em; color: var(--aw-accent); }
      .cobrand-x { color: var(--aw-muted); font-size: 0.8rem; }
      .cobrand-logo { height: 18px; width: auto; display: block; opacity: 0.92; }
      .backlink { font-size: 0.85rem; color: var(--aw-muted); font-weight: 500; transition: color var(--aw-base) var(--aw-ease); }
      .backlink:hover { color: var(--aw-accent-light); }

      /* ---- layout ---- */
      main > section { padding: 4rem 1.5rem; }
      .wrap { max-width: 960px; margin: 0 auto; }
      .band.alt { background: linear-gradient(180deg, rgba(34,69,201,0.07), rgba(79,164,216,0.02)); }
      .band.tightband { padding-top: 1rem; }
      .band-title { font-size: clamp(1.5rem, 3.6vw, 2.2rem); margin: 0.4rem 0 1.2rem; line-height: 1.06; }
      .sub-h { font-size: 1.05rem; margin: 1.6rem 0 0.7rem; text-transform: none; letter-spacing: 0; font-weight: 700; color: var(--aw-foreground); }
      .band-body { font-size: 1.05rem; line-height: 1.7; color: var(--aw-foreground); opacity: 0.92; margin: 0 0 1.2rem; }
      .band-body.lead { font-size: 1.12rem; max-width: 720px; }
      .context-note { font-size: 0.92rem; color: var(--aw-muted); line-height: 1.65; margin: 1rem 0 0; }

      /* ---- hero-lite ---- */
      .hero-lite {
        padding-top: 8rem !important; padding-bottom: 1rem !important;
        background: radial-gradient(1100px 420px at 50% -12%, rgba(34,69,201,0.35), transparent 60%);
      }
      .lite-title { font-size: clamp(2rem, 5.4vw, 3.6rem); line-height: 1.02; margin: 1rem 0 1.2rem; letter-spacing: -0.01em; }
      .hero-dim { color: var(--aw-accent); }

      /* ---- ledger (device + month) ---- */
      .ledger { border: 1px solid var(--aw-border); border-radius: var(--aw-radius-lg); overflow: hidden; background: var(--aw-surface); }
      .ledger-row { display: grid; grid-template-columns: 1fr 140px; align-items: center; padding: 0.85rem 1.4rem; border-top: 1px solid var(--aw-border); }
      .ledger-row:first-child { border-top: 0; }
      .l-line { font-size: 0.97rem; color: var(--aw-foreground); display: flex; flex-direction: column; gap: 0.1rem; }
      .l-line em { font-style: normal; font-size: 0.78rem; color: var(--aw-muted); }
      .l-amt { font-size: 1rem; text-align: right; font-weight: 500; color: var(--aw-foreground); }
      .ledger-row.cost .l-amt { color: var(--aw-muted); }
      .ledger-row.cost .l-amt::before { content: '− '; }
      .ledger-row.sub { background: var(--aw-surface-light); }
      .ledger-row.sub .l-line, .ledger-row.sub .l-amt { font-weight: 700; }
      .ledger-row.total { background: var(--aw-accent-soft); }
      .ledger-row.total .l-line { font-weight: 700; }
      .ledger-row.total .l-amt { font-family: var(--aw-font-display); font-weight: 900; font-size: 1.4rem; color: var(--aw-accent); }
      @media (max-width: 560px) { .ledger-row { grid-template-columns: 1fr 100px; padding-left: 1rem; padding-right: 1rem; } }

      /* ---- grid tables (subs + year one) ---- */
      .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .grid-table { border: 1px solid var(--aw-border); border-radius: var(--aw-radius-lg); overflow: hidden; min-width: 760px; }
      .g-head, .g-row { display: grid; align-items: center; }
      .sub-table .g-head, .sub-table .g-row { grid-template-columns: 1.3fr 1fr 1.3fr 0.9fr 0.9fr 1.2fr 1.3fr; }
      .y1-table .g-head, .y1-table .g-row { grid-template-columns: 1.7fr 0.8fr 0.9fr 0.8fr 0.9fr 1.1fr 1.3fr; }
      .g-head {
        background: var(--aw-surface-light); padding: 0.8rem 1.2rem; gap: 0.8rem;
        font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--aw-muted); font-weight: 700;
      }
      .g-row { padding: 0.85rem 1.2rem; gap: 0.8rem; border-top: 1px solid var(--aw-border); background: var(--aw-surface); font-size: 0.92rem; color: var(--aw-foreground); }
      .g-row.highlight { background: var(--aw-accent-soft); }
      .g-row span:first-child { font-weight: 500; }
      .g-accent { font-family: var(--aw-font-display); font-weight: 900; font-size: 1.1rem; color: var(--aw-accent); }
      .g-strong { font-weight: 700; color: var(--aw-accent-light); }
      .sub-group + .sub-group { margin-top: 0.4rem; }

      /* ---- parts ---- */
      .part-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
      .part-card { background: var(--aw-surface); border: 1px solid var(--aw-border); border-radius: var(--aw-radius-md); padding: 1.6rem 1.4rem; display: flex; flex-direction: column; }
      .part-num { font-size: 1.6rem; color: var(--aw-accent); opacity: 0.55; line-height: 1; margin-bottom: 0.7rem; }
      .part-card h4 { margin: 0 0 0.3rem; font-size: 1.05rem; }
      .part-amt { font-family: var(--aw-font-display); font-weight: 900; font-size: 1.25rem; color: var(--aw-accent); margin: 0 0 0.7rem; }
      .part-card p { margin: 0; color: var(--aw-muted); line-height: 1.6; font-size: 0.9rem; }
      @media (max-width: 760px) { .part-grid { grid-template-columns: 1fr; } }

      /* ---- rules ---- */
      .rule-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
      .rule-card { background: var(--aw-surface); border: 1px solid var(--aw-border); border-top: 2px solid var(--aw-accent); border-radius: var(--aw-radius-md); padding: 1.4rem; }
      .rule-card h4 { margin: 0 0 0.5rem; font-size: 1rem; }
      .rule-card p { margin: 0; color: var(--aw-muted); line-height: 1.55; font-size: 0.9rem; }
      @media (max-width: 760px) { .rule-list { grid-template-columns: 1fr; } }

      /* ---- close ---- */
      .band.close { background: radial-gradient(900px 420px at 50% 120%, rgba(34,69,201,0.34), transparent 62%); text-align: center; }
      .close-title { font-size: clamp(1.5rem, 4vw, 2.4rem); margin: 0.5rem auto 1.6rem; line-height: 1.06; }
      .cta-row { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

      /* ---- footer ---- */
      .site-footer {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
        padding: 2rem 1.5rem; border-top: 1px solid var(--aw-border);
        color: var(--aw-muted); font-size: 0.78rem; max-width: 960px; margin: 0 auto;
      }
      .footer-brand { display: flex; align-items: center; gap: 0.5rem; }

      @media (max-width: 560px) {
        main > section { padding: 3rem 1.2rem; }
        .topbar { padding: 0.75rem 1.1rem; }
        .hero-lite { padding-top: 6.5rem !important; }
      }
    </style>
  </body>
</html>
